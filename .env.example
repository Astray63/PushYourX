# Supabase — Dashboard > Project Settings > API
SUPABASE_URL=
# Clé serveur : contourne RLS. Ne jamais l'exposer au client.
SUPABASE_SERVICE_ROLE_KEY=

# Stripe. Absentes en développement => mode démo (mise validée sans paiement).
# En production, leur absence fait répondre 503 à /api/checkout.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Base des URLs de retour Stripe
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optionnel : clé HMAC des identifiants de visiteurs.
# À défaut, SUPABASE_SERVICE_ROLE_KEY sert de clé.
VISITOR_SALT=
